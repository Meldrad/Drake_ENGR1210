class Dog: 
    def __init__(self, name, age):
        self.name = name 
        self.age = age

    def sit(self):
        print(self.name + " is sitting")

    def roll_over(self):
        print(self.name + " rolled over!")

    def birthday(self):
        print("age is " + (self.age + 1))




my_dog = Dog('Willie', 6)
print("Name: " + my_dog.name)
print("Age: " + str(my_dog.age))
my_dog.sit()
my_dog.roll_over()

you_dog = Dog('Lucy', 3)
you_dog.sit()

my_dog.birthday()

